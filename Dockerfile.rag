FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-cache-dir '.[rag-service]' 'gunicorn>=23,<24'
ENV PORT=8080
USER 1000:1000
CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:$PORT --workers 1 --threads 4 --timeout 600 'reviewpilot.rag.service:app_from_env()'"]
